////////////////////////////////////////////////////////////////////////////////

DeathRealmCastle2b is DeathRealm

constants:

   include blakston.khd

resources:

   room_DeathRealm_castle2b = castle2b.roo

classvars:

   viTeleport_row = 8
   viTeleport_col = 13

   viWeatherZone = WEATHER_ZONE_BARLOQUE

properties:

   piDirectional_percent = DIRECTIONAL_PERCENT_OUTDOORS


   prRoom = room_DeathRealm_castle2b
   piRoom_num = RID_DCASTLE2B

messages:

   CreateStandardExits()
   {
      plExits = $;

      plExits = Cons([ 34, 73, ROOM_LOCKED_DOOR ],plExits);
      plExits = Cons([ 34, 74, ROOM_LOCKED_DOOR ],plExits);

      plExits = Cons([ 29, 59, ROOM_LOCKED_DOOR ],plExits);
      plExits = Cons([ 30, 59, ROOM_LOCKED_DOOR ],plExits);

      plExits = Cons([ 9, 37, ROOM_LOCKED_DOOR ],plExits);
      plExits = Cons([ 9, 38, ROOM_LOCKED_DOOR ],plExits);
      plExits = Cons([ 9, 39, ROOM_LOCKED_DOOR ],plExits);

      plExits = Cons([ 8, 58, ROOM_LOCKED_DOOR ],plExits);
      plExits = Cons([ 8, 59, ROOM_LOCKED_DOOR ],plExits);

      plExits = Cons([ 14,60, ROOM_LOCKED_DOOR ],plExits);
      plExits = Cons([ 15,60, ROOM_LOCKED_DOOR ],plExits);
      plExits = Cons([ 37,77, ROOM_LOCKED_DOOR ],plExits);
      plExits = Cons([ 37,78, ROOM_LOCKED_DOOR ],plExits);
      plExits = Cons([ 37,80, ROOM_LOCKED_DOOR ],plExits);
      plExits = Cons([ 38,80, ROOM_LOCKED_DOOR ],plExits);
      plExits = Cons([ 39,80, ROOM_LOCKED_DOOR ],plExits);
      plExits = Cons([ 40,80, ROOM_LOCKED_DOOR ],plExits);
      plExits = Cons([ 41,80, ROOM_LOCKED_DOOR ],plExits);
      plExits = Cons([ 42,77, ROOM_LOCKED_DOOR ],plExits);
      plExits = Cons([ 42,76, ROOM_LOCKED_DOOR ],plExits);
      plExits = Cons([ 42,74, ROOM_LOCKED_DOOR ],plExits);
      plExits = Cons([ 42,73, ROOM_LOCKED_DOOR ],plExits);
      plExits = Cons([ 42,72, ROOM_LOCKED_DOOR ],plExits);

      plEdge_exits = $;
      plEdge_Exits = Cons([ LEAVE_WEST, RID_DJ3, 37, 3, SET_ANGLE_EAST ], plEdge_exits); 

      propagate;
   }

end
